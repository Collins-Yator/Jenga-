# Jenga Construction Limited - Django Environment Variables Configuration
# Copy this file to .env and replace placeholders with your actual settings.
# NEVER commit .env to version control.

# Core Django Settings
DJANGO_SECRET_KEY=django-insecure-replace-with-a-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Company WhatsApp & Contact Configuration
JENGA_WHATSAPP_NUMBER=254792729492
COMPANY_CONTACT_EMAIL=info@jengaconstruction.co.ke
DEFAULT_FROM_EMAIL=Jenga Construction Limited <no-reply@jengaconstruction.co.ke>

# Email Configuration
# During local development, console backend logs outgoing emails to the terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production SMTP, uncomment and populate:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True

# Database Configuration (Defaults to SQLite for local development)
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/jenga_db

# Google Maps Embed URL (Configurable - leave blank until verified)
GOOGLE_MAPS_EMBED_URL=
